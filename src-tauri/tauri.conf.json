{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tdeeeg",
  "version": "0.1.1",
  "identifier": "com.xiaoqvan.tdeeeg",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tdeeeg",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost tdstream: http://tdstream.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assets/*", "../assets/*", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["./bin/*"]
  }
}
