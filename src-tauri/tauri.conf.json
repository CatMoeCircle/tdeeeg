{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tdeeeg",
  "version": "0.1.6",
  "identifier": "com.xiaoqvan.tdeeeg",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tdeeeg",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data: asset: http://asset.localhost; img-src 'self' data: asset: http://asset.localhost; media-src 'self' data: asset: http://asset.localhost tdstream: http://tdstream.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assets/*", "../assets/*", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "resources": ["./bin/*"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0MEJDREUyMjU3MEQxMDkKUldRSjBYQWw0czBMSlBBVnFhZEE3d294MCtnLzBpZmdxSG5JYWl5SnFjZUNpcnNYeE1JYUg1c3oK",
      "endpoints": [
        "https://github.com/CatMoeCircle/tdeeeg/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
